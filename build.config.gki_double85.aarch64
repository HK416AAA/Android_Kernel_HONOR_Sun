KERNEL_DIR=common
DEFCONFIG=double85_defconfig
FRAGMENT_CONFIG_CNPERF=${KERNEL_DIR}/arch/arm64/configs/cnperf.fragment
FRAGMENT_CONFIG_CONSOLIDATE=${KERNEL_DIR}/arch/arm64/configs/consolidate.fragment
FRAGMENT_CONFIG_FACTORY=${KERNEL_DIR}/arch/arm64/configs/factory.fragment
FRAGMENT_CONFIG_DOUBLE85=${KERNEL_DIR}/arch/arm64/configs/double85.fragment
PRE_DEFCONFIG_CMDS="KCONFIG_CONFIG=${ROOT_DIR}/${KERNEL_DIR}/arch/arm64/configs/${DEFCONFIG} ${ROOT_DIR}/${KERNEL_DIR}/scripts/kconfig/merge_config.sh -m -r ${ROOT_DIR}/${KERNEL_DIR}/arch/arm64/configs/gki_defconfig ${ROOT_DIR}/${FRAGMENT_CONFIG_CNPERF} ${ROOT_DIR}/${FRAGMENT_CONFIG_CONSOLIDATE} ${ROOT_DIR}/${FRAGMENT_CONFIG_FACTORY} ${ROOT_DIR}/${FRAGMENT_CONFIG_DOUBLE85}"

POST_DEFCONFIG_CMDS="check_merged_defconfig_for_kernel_common"
append_cmd POST_DEFCONFIG_CMDS "rm ${ROOT_DIR}/${KERNEL_DIR}/arch/arm64/configs/${DEFCONFIG}"
