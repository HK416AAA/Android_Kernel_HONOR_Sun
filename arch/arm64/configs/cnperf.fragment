# Kconfigs for performance build
CONFIG_MAGIC_SYSRQ_DEFAULT_ENABLE=0
CONFIG_HONOR_DEBUG=n


# config memory
CONFIG_HONOR_ALLOC_STACK_PAGE_ON_DEMAND=y
CONFIG_HONOR_MEM_STATS=y
CONFIG_HONOR_DMABUF_MEMINFO=y
CONFIG_HONOR_PRINTK_PREFIX=y
CONFIG_HONOR_CPU_FREQ_POWER_STAT=y
CONFIG_HN_VIP_TO_TA_BUILDIN=y
CONFIG_HN_SCHED_TRACE_ENHANCEMENT=y
CONFIG_HONOR_BINDER_TRANSACTION_BRIEF=y
CONFIG_HONOR_DIE_CATCH=y

CONFIG_HONOR_UFS_DSM=y
CONFIG_HONOR_F2FS_DSM=y
CONFIG_HONOR_F2FS_SMART_DISCARD=y
CONFIG_HONOR_BLOCK_MQ_DEADLINE=y
CONFIG_HONOR_PSI=y
CONFIG_HONOR_F2FS_BLKFRAG=y
CONFIG_HONOR_BLK_CGROUP_IOSMART=y
CONFIG_HONOR_BLK_CGROUP_IOLIMIT=y
CONFIG_HONOR_F2FS_HOTNESS_CLUSTERING=y
CONFIG_HONOR_IO_MEASURE=y
CONFIG_HONOR_CACHE_DISK=y

CONFIG_HONOR_THREAD_STACK_STAT=y

CONFIG_HONOR_VIP_THREAD_BUILDIN=y
CONFIG_HONOR_BOOT_TIME=y

#config for PGO
CONFIG_HONOR_PGO_CLANG=y

CONFIG_STATIC_USERMODEHELPER_PATH="/system_ext/bin/coredumpzip"
